PORT=3000
DB_URL=mongodb+srv://<user>:<pass>@cluster.mongodb.net
DB_NAME=user_db
CORS_ORIGIN=http://localhost:5173

# JWT - use a strong random secret (at least 32 characters) and never commit real values
ACCESS_SECRET=your-long-random-secret-at-least-32-chars
ACCESS_EXPIRES_IN=1h

# Brevo transactional email (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=First App
